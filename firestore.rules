rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 유틸리티 함수: 로그인 여부 확인
    function isSignedIn() {
      return request.auth != null;
    }
    
    // 유틸리티 함수: 본인 데이터인지 확인
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. 사용자 프로필 데이터 규칙
    match /users/{userId}/profile/data {
      allow read: if true; // 누구나 프로필 조회 가능
      allow write: if isOwner(userId); // 본인만 수정 가능
    }

    // 2. 링크 목록 데이터 규칙
    match /users/{userId}/links/{linkId} {
      allow read: if true; // 누구나 링크 목록 조회 가능
      allow create, delete: if isOwner(userId); // 본인만 추가/삭제 가능
      
      // 업데이트 규칙:
      // - 소유자는 모든 수정 가능
      // - 타인은 clickCount 필드만 수정 가능 (조회수 증가용)
      allow update: if isOwner(userId) || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount']);
    }

    // 3. User Name (Slug) 중복 방지 및 소유권 규칙
    match /displayNames/{displayName} {
      allow read: if true;
      
      // 생성: 로그인되어 있고, 데이터의 uid가 내 것이어야 함
      allow create: if isSignedIn() 
        && request.resource.data.uid == request.auth.uid;
        
      // 수정/삭제: 기존 데이터의 소유자만 가능
      allow update, delete: if isSignedIn() 
        && resource.data.uid == request.auth.uid;
    }
  }
}
